# Copy to .env.local. Every variable is optional on Vercel.

# Public URL of this app. Required when using a tunnel or self-hosting.
# BASE_URL=https://xxxx.ngrok-free.app

# Public MCP server URL, if it isn't `${BASE_URL}/mcp`. Used to compute
# Claude's sandbox domain.
# MCP_SERVER_URL=https://my-app.example.com/mcp

# Extra browser origins allowed to call /mcp (comma-separated hostnames or
# origins), e.g. a deployed MCP Inspector or basic-host.
# MCP_ALLOWED_ORIGINS=localhost,inspector.example.com

# Dedicated sandbox origin in Claude: "auto" (computed from MCP_SERVER_URL) or
# an explicit `{hash}.claudemcpcontent.com`. Only needed for a stable origin
# (own OAuth flow, CORS allowlists, embedded sites).
# CLAUDE_WIDGET_DOMAIN=auto

# Dedicated sandbox origin in ChatGPT. Required to submit an app with UI.
# CHATGPT_WIDGET_DOMAIN=https://my-app.example.com

# Token for ChatGPT's domain verification at /.well-known/openai-apps-challenge.
# OPENAI_APPS_CHALLENGE_TOKEN=
